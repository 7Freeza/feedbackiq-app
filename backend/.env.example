# FeedbackIQ backend
PORT=4004
CORS_ORIGIN=http://localhost:5173
EXPORT_DIR=../exports
MAX_UPLOAD_MB=80
# Precio de referencia USD por millón de tokens (configurable en UI también)
REFERENCE_PRICE_PER_MILLION=2.50
# Volumen diario de referencia para proyecciones
DEFAULT_DAILY_VOLUME=10000

# --- Reportes de problemas → n8n (ver docs/N8N_REPORTES.md) ---
# Deja vacío hasta crear el Webhook en n8n; luego pega la URL de producción del webhook.
N8N_WEBHOOK_URL=
# Secreto compartido (mismo valor que configures en Header Auth del Webhook n8n)
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_HEADER_NAME=X-FeedbackIQ-Secret
N8N_TIMEOUT_SEC=15
# true = aceptar reportes sin n8n (solo clasifica local; útil para probar el form)
N8N_DRY_RUN=true
